      "type": "service",
      "name": "rabbitmq",
      "filePath": "docker-compose.yml",
      "lineRange": [57, 73],
      "summary": "RabbitMQ 消息队列服务，用于异步消息处理和向量处理任务调度，映射 5672（通信）和 15672（管理界面）端口。",
      "tags": ["message-queue", "middleware", "infrastructure", "async-processing"],
      "complexity": "simple"
    },
