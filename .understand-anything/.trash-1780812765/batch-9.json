    {
      "id": "file:FoxChatRAG-python/app/retriever/project_retriever.py",
      "type": "file",
      "name": "project_retriever.py",
      "filePath": "FoxChatRAG-python/app/retriever/project_retriever.py",
      "summary": "项目检索器模块，封装 BM25 和向量检索能力，支持中文分词（jieba）、Chroma 向量数据库查询，以及两种检索器的 Ensemble 混合检索。",
      "tags": ["retrieval", "rag", "search", "nlp"],
      "complexity": "moderate",
      "languageNotes": "使用 jieba 进行中文分词，BM25 与向量检索权重 0.4:0.6 混合。"
    },
